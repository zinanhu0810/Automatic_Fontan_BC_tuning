<?xml version="1.0" encoding="UTF-8"?>
<svMultiPhysicsFile version="0.1">
  <GeneralSimulationParameters>
    <Continue_previous_simulation> false </Continue_previous_simulation>
    <Number_of_spatial_dimensions> 3 </Number_of_spatial_dimensions>
    <Number_of_time_steps> 8000 </Number_of_time_steps>
    <Time_step_size> 0.000667 </Time_step_size>
    <Spectral_radius_of_infinite_time_step> 0.50 </Spectral_radius_of_infinite_time_step>
    <Searched_file_name_to_trigger_stop> STOP_SIM </Searched_file_name_to_trigger_stop>
    <Save_results_to_VTK_format> 1 </Save_results_to_VTK_format>
    <Name_prefix_of_saved_VTK_files> result </Name_prefix_of_saved_VTK_files>
    <Increment_in_saving_VTK_files> 100 </Increment_in_saving_VTK_files>
    <Start_saving_after_time_step> 1 </Start_saving_after_time_step>
    <Increment_in_saving_restart_files> 1000 </Increment_in_saving_restart_files>
    <Verbose> 1 </Verbose>
  </GeneralSimulationParameters>
  <Add_mesh name="msh">
    <Mesh_file_path> ./mesh/lumen_mesh.vtu </Mesh_file_path>
    <Add_face name="lpa"><Face_file_path> ./mesh/mesh-surfaces/LPA.vtp </Face_file_path></Add_face>
    <Add_face name="rpa"><Face_file_path> ./mesh/mesh-surfaces/RPA.vtp </Face_file_path></Add_face>
    <Add_face name="rpa2"><Face_file_path> ./mesh/mesh-surfaces/RPA_branch2.vtp </Face_file_path></Add_face>
    <Add_face name="rpa3"><Face_file_path> ./mesh/mesh-surfaces/RPA_branch3.vtp </Face_file_path></Add_face>
    <Add_face name="rpa4"><Face_file_path> ./mesh/mesh-surfaces/RPA_branch4.vtp </Face_file_path></Add_face>
    <Add_face name="rpa5"><Face_file_path> ./mesh/mesh-surfaces/RPA_branch5.vtp </Face_file_path></Add_face>
    <Add_face name="svc"><Face_file_path> ./mesh/mesh-surfaces/SVC.vtp </Face_file_path></Add_face>
    <Add_face name="ivc"><Face_file_path> ./mesh/mesh-surfaces/IVC.vtp </Face_file_path></Add_face>
    <Add_face name="wall"><Face_file_path> ./mesh/mesh-surfaces/lumen_wall.vtp </Face_file_path></Add_face>
  </Add_mesh>
  <Add_equation type="fluid">
    <Coupled> 1 </Coupled>
    <Min_iterations> 3 </Min_iterations>
    <Max_iterations> 10 </Max_iterations>
    <Tolerance> 1e-3 </Tolerance>
    <Backflow_stabilization_coefficient> 0.2 </Backflow_stabilization_coefficient>
    <Density> 1.06 </Density>
    <Viscosity model="Constant"><Value> 0.04 </Value></Viscosity>
    <Output type="Spatial"><Velocity> true </Velocity><Pressure> true </Pressure><Traction> true </Traction><WSS> true </WSS><Vorticity> true </Vorticity><Divergence> true </Divergence></Output>
    <Output type="Volume_integral"><Volume> true </Volume></Output>
    <Output type="Boundary_integral"><Pressure> true </Pressure><Velocity> true </Velocity></Output>
    <LS type="NS">
      <Linear_algebra type="fsils"><Preconditioner> fsils </Preconditioner></Linear_algebra>
      <Max_iterations> 10 </Max_iterations><NS_GM_max_iterations> 3 </NS_GM_max_iterations><NS_CG_max_iterations> 500 </NS_CG_max_iterations>
      <Tolerance> 1e-3 </Tolerance><NS_GM_tolerance> 1e-3 </NS_GM_tolerance><NS_CG_tolerance> 1e-3 </NS_CG_tolerance><Krylov_space_dimension> 50 </Krylov_space_dimension>
    </LS>
    <svZeroDSolver_interface>
      <Coupling_type> semi-implicit </Coupling_type>
      <Configuration_file> 0d/Fontan_3d_coupled.json </Configuration_file>
      <Shared_library> __SVZERO_INTERFACE_LIB__ </Shared_library>
      <Initial_flows> 0.0 </Initial_flows>
      <Initial_pressures> 0.0 </Initial_pressures>
    </svZeroDSolver_interface>
    <Add_BC name="lpa"><Type> Neu </Type><Time_dependence> Coupled </Time_dependence><svZeroDSolver_block> lpa </svZeroDSolver_block></Add_BC>
    <Add_BC name="rpa"><Type> Neu </Type><Time_dependence> Coupled </Time_dependence><svZeroDSolver_block> rpa </svZeroDSolver_block></Add_BC>
    <Add_BC name="rpa2"><Type> Neu </Type><Time_dependence> Coupled </Time_dependence><svZeroDSolver_block> rpa2 </svZeroDSolver_block></Add_BC>
    <Add_BC name="rpa3"><Type> Neu </Type><Time_dependence> Coupled </Time_dependence><svZeroDSolver_block> rpa3 </svZeroDSolver_block></Add_BC>
    <Add_BC name="rpa4"><Type> Neu </Type><Time_dependence> Coupled </Time_dependence><svZeroDSolver_block> rpa4 </svZeroDSolver_block></Add_BC>
    <Add_BC name="rpa5"><Type> Neu </Type><Time_dependence> Coupled </Time_dependence><svZeroDSolver_block> rpa5 </svZeroDSolver_block></Add_BC>
    <Add_BC name="svc"><Type> Neu </Type><Time_dependence> Coupled </Time_dependence><svZeroDSolver_block> svc </svZeroDSolver_block></Add_BC>
    <Add_BC name="ivc"><Type> Neu </Type><Time_dependence> Coupled </Time_dependence><svZeroDSolver_block> ivc </svZeroDSolver_block></Add_BC>
    <Add_BC name="wall"><Type> Dir </Type><Time_dependence> Steady </Time_dependence><Value> 0 </Value></Add_BC>
  </Add_equation>
</svMultiPhysicsFile>
